{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mid-daily-api",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "TOKEN_ENCRYPTION_KEY_B64"
    ]
  }
}
