{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mid-daily-api",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat_populate_process_env"
  ],
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SUPABASE_URL": "https://ywpvwxhfzgxwmxrwcfsf.supabase.co",
    "FRONTEND_URL": "https://mid-daily.e41262272.workers.dev",
    "GOOGLE_REDIRECT_URI": "https://mid-daily-api.e41262272.workers.dev/auth/google/callback",
    "COOKIE_SECURE": "true",
    "APP_TIMEZONE": "Asia/Jakarta",
    "INSTAGRAM_REDIRECT_URI": "https://mid-daily-api.e41262272.workers.dev/auth/instagram/callback"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "TOKEN_ENCRYPTION_KEY_B64"
    ]
  }
}
