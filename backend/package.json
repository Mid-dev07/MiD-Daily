  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "openai": "^7.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": "22.x"
  }
}
